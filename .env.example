# Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Analytics — omit to disable.
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Google Sign-In client ID (OAuth 2.0 Client ID, Web application type) from
# https://console.cloud.google.com/apis/credentials. Must match the backend's
# Authentication__Google__ClientId. Omit to hide the Google button behind a disabled placeholder.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
